# Пример конфигурации окружения для AI Browser
# Скопируйте этот файл в .env и заполните своими значениями

# === Режим разработки ===
NODE_ENV=development

# === Логирование ===
LOG_LEVEL=info

# === API ключи ===
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google
GOOGLE_API_KEY=your_google_api_key_here

# === Redis (для управления сессиями) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === n8n интеграция ===
N8N_URL=http://localhost:5678
N8N_API_KEY=

# === Прокси (опционально) ===
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# === Другие настройки ===
# Порт для backend API
API_PORT=3000

# Максимальное количество вкладок
MAX_TABS=20

# Timeout для web-based моделей (секунды)
WEB_MODEL_TIMEOUT=60
